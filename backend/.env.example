# Backend Settings — read by backend/app/config.py.
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# Local Supabase Postgres (started by `make db-start`). Hosted equivalent:
#   postgresql://postgres:<db-password>@db.your-project.supabase.co:5432/postgres
# Per CLAUDE.md, Supabase is "Auth only" — backend DB stays local for the hackathon.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase — used by the JWT-verification dep (via JWKS) and any service-role scripts.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs — only used by backend/scripts/setup_eleven_agent.py and POST /govuk/refresh.
# Same value as frontend/.env XI_API_KEY; never accessed at request time.
XI_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
XI_VOICE_ID_ENGLISH=
XI_VOICE_ID_WELSH=
