# Frontend config — browser-safe vars validated by frontend/lib/env.ts (env),
# the server-only secret by serverEnv(). Placeholders only — never real secrets.

# --- ElevenLabs (Conversational AI) -----------------------------------------
# Server-only. Read by /api/eleven/signed-url (via serverEnv) to issue signed
# WebSocket URLs. NEVER prefix with NEXT_PUBLIC_ — that ships the key to the
# browser. It is the one var here the client bundle must never see.
XI_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Agent ID is safe to expose: a signed URL is required to actually connect.
# Written into frontend/.env by backend/scripts/setup_eleven_agent.py.
NEXT_PUBLIC_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Two voices: native English for the default session, native Welsh for the
# session restarted when the user asks for Welsh. NEXT_PUBLIC_ because the
# convai client leaf reads them to set overrides.tts.voice_id per session.
NEXT_PUBLIC_XI_VOICE_ID_ENGLISH=YCMgeo2Dvws6xwm7kQNN
NEXT_PUBLIC_XI_VOICE_ID_WELSH=73fZMjboCm1aBVyxTbBp

# --- FastAPI (the only data path) -------------------------------------------
# Where the browser calls our backend. Local: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase Auth — browser flow only (per CLAUDE.md, no app-table access) --
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- One Login simulator (mocked auth) --------------------------------------
# Points at the local Docker container running ghcr.io/govuk-one-login/simulator.
NEXT_PUBLIC_ONE_LOGIN_URL=http://localhost:3001
