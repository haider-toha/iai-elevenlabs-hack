# Frontend config — validated by frontend/lib/env.ts at boundary.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth — browser flow only (per CLAUDE.md, no app-table access from the client).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs — bare name = server-only. NEVER add NEXT_PUBLIC_ to this; it would
# ship the key to the browser. Read by /api/eleven/signed-url route handler.
XI_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Voice IDs — applied per-session via SDK overrides. Pick from the ElevenLabs
# voice library: English = warm UK voice (e.g. Charlotte, Alice); Welsh = native
# Welsh voice (used after a session-restart triggered by the language-switch tool).
XI_VOICE_ID_ENGLISH=
XI_VOICE_ID_WELSH=

# Written by backend/scripts/setup_eleven_agent.py on first run. Safe to expose;
# useless without a signed URL because the agent requires auth.
NEXT_PUBLIC_AGENT_ID=
